+	if (blockEnd > getblockchaininfo.blocks) {
+		blockEnd = getblockchaininfo.blocks;
+	}
+
 	const promises = [];
 
 	const blockCount = Math.floor((blockEnd - blockStart) / dataPtCount) || 1;
@@ -552,7 +560,7 @@ async function getTxStats(dataPtCount, blockStart, blockEnd) {
 
