 		// recently started node - no meaningful data to return
 		return null;
 	}
@@ -577,7 +585,11 @@ async function getTxStats(dataPtCount, blockStart, blockEnd) {
 		}
 	}
 
-	summary.avgTimespan = (totalTimespan / results.length);
+	if (summary.txCounts.length == 0) {
+		return null;
+	}
+
+	summary.avgTimespan = (totalTimespan / summary.txCounts.length);
 
 	miscCache.set(cacheKey, summary, 60 * ONE_MIN);
 
